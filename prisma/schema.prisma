generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EXPORTER
  MIDDLEMAN
  FARMER
  FREIGHT_FORWARDER
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  taxId     String   @unique
  phone     String
  email     String   @unique
  password  String   // รหัสผ่านแฮชด้วย bcrypt
  role      Role     @default(EXPORTER)
  createdAt DateTime @default(now())

  documents Document[]
}

model Transaction {
  id          String   @id @default(uuid())
  code        String   @unique
  product     String
  quantity    String
  price       String
  destination String
  incoterm    String
  status      String   @default("เตรียมเอกสาร")
  createdAt   DateTime @default(now())

  documents   Document[]
}

model Document {
  id             String      @id @default(uuid())
  filename       String
  filePath       String
  isConfidential Boolean     @default(false)
  uploadedByRole Role
  uploadedAt     DateTime    @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id])
  
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}